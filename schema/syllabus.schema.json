{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/p-n-ai/oss/schema/syllabus.schema.json",
  "title": "Syllabus",
  "description": "Top-level curriculum metadata and its declared subjects.",
  "type": "object",
  "required": [
    "id",
    "name",
    "name_en",
    "country_id",
    "language",
    "subjects",
    "provenance",
    "generated_at"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/nonEmptyString" },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "name_en": { "$ref": "#/$defs/nonEmptyString" },
    "country_id": { "$ref": "#/$defs/nonEmptyString" },
    "language": { "$ref": "#/$defs/nonEmptyString" },
    "description": { "$ref": "#/$defs/nonEmptyString" },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "provenance": { "$ref": "#/$defs/nonEmptyString" },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}
