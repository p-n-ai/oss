{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/p-n-ai/oss/schema/subject-grade.schema.json",
  "title": "Subject grade",
  "description": "A grade- or phase-specific subject and its complete canonical topic inventory.",
  "type": "object",
  "required": [
    "id",
    "name",
    "name_en",
    "subject_id",
    "syllabus_id",
    "grade_id",
    "country_id",
    "language",
    "topics"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/nonEmptyString" },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "name_en": { "$ref": "#/$defs/nonEmptyString" },
    "subject_id": { "$ref": "#/$defs/nonEmptyString" },
    "syllabus_id": { "$ref": "#/$defs/nonEmptyString" },
    "grade_id": { "$ref": "#/$defs/nonEmptyString" },
    "country_id": { "$ref": "#/$defs/nonEmptyString" },
    "language": { "$ref": "#/$defs/nonEmptyString" },
    "description": { "$ref": "#/$defs/nonEmptyString" },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/topicId" }
    },
    "provenance": { "$ref": "#/$defs/nonEmptyString" },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "topicId": {
      "type": "string",
      "pattern": "^(?:[A-Z]{2,3}[0-9]+|[A-Z]{2,3}-[A-Z])-[0-9]{2}$"
    }
  }
}
