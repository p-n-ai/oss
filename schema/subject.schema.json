{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/p-n-ai/oss/schema/subject.schema.json",
  "title": "Subject",
  "description": "A subject declared by a syllabus.",
  "type": "object",
  "required": [
    "id",
    "name",
    "name_en",
    "syllabus_id",
    "country_id",
    "language",
    "provenance",
    "generated_at"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/nonEmptyString" },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "name_en": { "$ref": "#/$defs/nonEmptyString" },
    "syllabus_id": { "$ref": "#/$defs/nonEmptyString" },
    "country_id": { "$ref": "#/$defs/nonEmptyString" },
    "language": { "$ref": "#/$defs/nonEmptyString" },
    "provenance": { "$ref": "#/$defs/nonEmptyString" },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}
