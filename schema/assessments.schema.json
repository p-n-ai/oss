{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/p-n-ai/oss/schema/assessments.schema.json",
  "title": "Assessments",
  "description": "Assessment questions for one canonical topic or locale variant.",
  "type": "object",
  "required": ["topic_id", "questions"],
  "properties": {
    "id": { "$ref": "#/$defs/nonEmptyString" },
    "topic_id": { "$ref": "#/$defs/topicId" },
    "provenance": { "$ref": "#/$defs/nonEmptyString" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "topicId": {
      "type": "string",
      "pattern": "^(?:[A-Z]{2,3}[0-9]+|[A-Z]{2,3}-[A-Z])-[0-9]{2}$"
    },
    "questionId": {
      "type": "string",
      "pattern": "^(Q[0-9]+|(?:[A-Z]{2,3}[0-9]+|[A-Z]{2,3}-[A-Z])-[0-9]{2}-Q[0-9]+)$"
    },
    "optionSet": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/nonEmptyString" }
        }
      ]
    },
    "distractor": {
      "type": "object",
      "required": ["value", "feedback"],
      "properties": {
        "value": { "$ref": "#/$defs/nonEmptyString" },
        "feedback": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "answer": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "exact",
            "range",
            "multiple_choice",
            "true_false",
            "matching",
            "free_text",
            "structured",
            "structured_response",
            "subjective",
            "opb"
          ]
        },
        "value": { "$ref": "#/$defs/nonEmptyString" },
        "working": { "$ref": "#/$defs/nonEmptyString" },
        "options": { "$ref": "#/$defs/optionSet" },
        "mapping": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["left", "right"],
            "properties": {
              "left": { "$ref": "#/$defs/nonEmptyString" },
              "right": { "$ref": "#/$defs/nonEmptyString" }
            },
            "additionalProperties": false
          }
        },
        "distractors": {
          "type": "array",
          "items": { "$ref": "#/$defs/distractor" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "matching" }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["pairs"],
            "not": {
              "anyOf": [
                { "required": ["value"] },
                { "required": ["mapping"] }
              ]
            }
          },
          "else": {
            "required": ["value"],
            "not": { "required": ["pairs"] }
          }
        }
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "text",
        "difficulty",
        "learning_objective",
        "tp_level",
        "answer"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/questionId" },
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard"]
        },
        "learning_objective": { "$ref": "#/$defs/nonEmptyString" },
        "tp_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "kbat": { "type": "boolean" },
        "type": { "$ref": "#/$defs/nonEmptyString" },
        "answer": { "$ref": "#/$defs/answer" },
        "marks": {
          "type": "integer",
          "minimum": 1
        },
        "rubric": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["marks", "criteria"],
            "properties": {
              "marks": {
                "type": "integer",
                "minimum": 1
              },
              "criteria": { "$ref": "#/$defs/nonEmptyString" }
            },
            "additionalProperties": false
          }
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["level", "text"],
            "properties": {
              "level": {
                "type": "integer",
                "minimum": 1
              },
              "text": { "$ref": "#/$defs/nonEmptyString" }
            },
            "additionalProperties": false
          }
        },
        "distractors": {
          "type": "array",
          "items": { "$ref": "#/$defs/distractor" }
        }
      },
      "additionalProperties": false
    }
  }
}
