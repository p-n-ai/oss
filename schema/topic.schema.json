{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/p-n-ai/oss/schema/topic.schema.json",
  "title": "Canonical topic",
  "description": "A canonical teachable unit. Canonical topic IDs are globally unique.",
  "type": "object",
  "required": [
    "id",
    "official_ref",
    "subject_grade_id",
    "subject_id",
    "syllabus_id",
    "content_standards"
  ],
  "anyOf": [
    { "required": ["name"] },
    { "required": ["name_en"] }
  ],
  "properties": {
    "id": { "$ref": "#/$defs/topicId" },
    "official_ref": { "$ref": "#/$defs/nonEmptyString" },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "name_en": { "$ref": "#/$defs/nonEmptyString" },
    "subject_grade_id": { "$ref": "#/$defs/nonEmptyString" },
    "subject_id": { "$ref": "#/$defs/nonEmptyString" },
    "syllabus_id": { "$ref": "#/$defs/nonEmptyString" },
    "country_id": { "$ref": "#/$defs/nonEmptyString" },
    "language": { "$ref": "#/$defs/nonEmptyString" },
    "description": { "$ref": "#/$defs/nonEmptyString" },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"]
    },
    "tier": {
      "type": "string",
      "enum": ["core", "extended"]
    },
    "theme": { "$ref": "#/$defs/nonEmptyString" },
    "textbook_pages": { "$ref": "#/$defs/nonEmptyString" },
    "content_standards": {
      "type": "array",
      "description": "May be empty for a quality_level 0 catalog stub.",
      "items": { "$ref": "#/$defs/contentStandard" }
    },
    "learning_objectives": {
      "type": "array",
      "description": "May be empty for a quality_level 0 catalog stub; quality_level 1 and above require at least one root learning objective.",
      "items": { "$ref": "#/$defs/learningObjective" }
    },
    "prerequisites": { "$ref": "#/$defs/prerequisites" },
    "background_knowledge": { "$ref": "#/$defs/stringArray" },
    "bloom_levels": { "$ref": "#/$defs/stringArray" },
    "mastery": { "$ref": "#/$defs/mastery" },
    "teaching": { "$ref": "#/$defs/teaching" },
    "engagement_hooks": { "$ref": "#/$defs/stringArray" },
    "performance_standards": {
      "type": "array",
      "items": { "$ref": "#/$defs/performanceStandard" }
    },
    "performance_levels": {
      "type": "array",
      "items": { "$ref": "#/$defs/performanceStandard" }
    },
    "cross_curriculum": {
      "type": "array",
      "items": { "$ref": "#/$defs/crossCurriculum" }
    },
    "citizenship_elements": {
      "type": "array",
      "items": { "$ref": "#/$defs/citizenshipElement" }
    },
    "historical_thinking_skills": { "$ref": "#/$defs/stringArray" },
    "topic_focus": { "$ref": "#/$defs/stringArray" },
    "topic_empathy": { "$ref": "#/$defs/stringArray" },
    "ai_teaching_notes": { "$ref": "#/$defs/nonEmptyString" },
    "examples_file": { "$ref": "#/$defs/nonEmptyString" },
    "assessments_file": { "$ref": "#/$defs/nonEmptyString" },
    "quality_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "Completeness claim. Level 0 is a non-teachable catalog stub; the quality gate requires a nonempty teaching identity from level 1."
    },
    "provenance": { "$ref": "#/$defs/nonEmptyString" },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sync_checked": { "type": "boolean" }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "topicId": {
      "type": "string",
      "pattern": "^(?:[A-Z]{2,3}[0-9]+|[A-Z]{2,3}-[A-Z])-[0-9]{2}$"
    },
    "tpLevel": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        }
      ]
    },
    "tpMapping": {
      "type": "object",
      "patternProperties": {
        "^tp[1-6]$": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "learningObjectiveBase": {
      "type": "object",
      "required": ["id"],
      "anyOf": [
        { "required": ["text"] },
        { "required": ["text_en"] }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "text_en": { "$ref": "#/$defs/nonEmptyString" },
        "bloom": {
          "type": "string",
          "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]
        },
        "content_standard_id": { "$ref": "#/$defs/nonEmptyString" },
        "tp_level": { "$ref": "#/$defs/tpLevel" },
        "tp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "tp_mapping": { "$ref": "#/$defs/tpMapping" },
        "is_citizenship_elements": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "learningObjective": {
      "$ref": "#/$defs/learningObjectiveBase"
    },
    "contentStandard": {
      "type": "object",
      "required": ["id"],
      "anyOf": [
        { "required": ["text"] },
        { "required": ["text_en"] }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "text_en": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "prerequisiteItem": {
      "oneOf": [
        { "$ref": "#/$defs/topicId" },
        {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "$ref": "#/$defs/topicId" },
            "name": { "$ref": "#/$defs/nonEmptyString" },
            "name_en": { "$ref": "#/$defs/nonEmptyString" },
            "reason": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        }
      ]
    },
    "prerequisites": {
      "type": "object",
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "items": { "$ref": "#/$defs/prerequisiteItem" }
        },
        "recommended": {
          "type": "array",
          "items": { "$ref": "#/$defs/prerequisiteItem" }
        },
        "description": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "spacedRepetition": {
      "type": "object",
      "required": ["initial_interval_days", "multiplier"],
      "properties": {
        "initial_interval_days": {
          "type": "integer",
          "minimum": 1
        },
        "multiplier": {
          "type": "number",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "mastery": {
      "type": "object",
      "required": ["minimum_score", "assessment_count"],
      "properties": {
        "minimum_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "assessment_count": {
          "type": "integer",
          "minimum": 1
        },
        "spaced_repetition": { "$ref": "#/$defs/spacedRepetition" }
      },
      "additionalProperties": false
    },
    "misconception": {
      "type": "object",
      "required": ["misconception", "remediation"],
      "properties": {
        "misconception": { "$ref": "#/$defs/nonEmptyString" },
        "remediation": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "misconceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/misconception" }
    },
    "teaching": {
      "type": "object",
      "required": ["sequence"],
      "properties": {
        "sequence": { "$ref": "#/$defs/stringArray" },
        "common_misconceptions": { "$ref": "#/$defs/misconceptions" },
        "engagement_hooks": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "performanceStandard": {
      "type": "object",
      "allOf": [
        {
          "anyOf": [
            { "required": ["level"] },
            { "required": ["id"] },
            { "required": ["tp_level"] }
          ]
        },
        {
          "anyOf": [
            { "required": ["text"] },
            { "required": ["text_en"] },
            { "required": ["descriptor"] },
            { "required": ["descriptor_en"] },
            { "required": ["description"] }
          ]
        }
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "tp_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "text_en": { "$ref": "#/$defs/nonEmptyString" },
        "descriptor": { "$ref": "#/$defs/nonEmptyString" },
        "descriptor_en": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "crossCurriculum": {
      "type": "object",
      "required": ["concept_id", "syllabus_id", "topic_id"],
      "properties": {
        "concept_id": { "$ref": "#/$defs/nonEmptyString" },
        "syllabus_id": { "$ref": "#/$defs/nonEmptyString" },
        "topic_id": { "$ref": "#/$defs/topicId" }
      },
      "additionalProperties": false
    },
    "citizenshipElement": {
      "type": "object",
      "required": ["id", "content_standard_id"],
      "anyOf": [
        { "required": ["text"] },
        { "required": ["text_en"] }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "content_standard_id": { "$ref": "#/$defs/nonEmptyString" },
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "text_en": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    }
  }
}
