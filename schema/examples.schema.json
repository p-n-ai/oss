{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/p-n-ai/oss/schema/examples.schema.json",
  "title": "Worked examples",
  "description": "Worked examples for one canonical topic or locale variant.",
  "type": "object",
  "required": ["topic_id", "worked_examples"],
  "properties": {
    "id": { "$ref": "#/$defs/nonEmptyString" },
    "topic_id": { "$ref": "#/$defs/topicId" },
    "provenance": { "$ref": "#/$defs/nonEmptyString" },
    "description": { "$ref": "#/$defs/nonEmptyString" },
    "worked_examples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workedExample" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "topicId": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}[0-9]+-[0-9]{2}$"
    },
    "workedExample": {
      "type": "object",
      "required": [
        "id",
        "topic",
        "difficulty",
        "misconception_alert",
        "scenario",
        "working"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^WE-[0-9]+$"
        },
        "topic": { "$ref": "#/$defs/nonEmptyString" },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard"]
        },
        "tp_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "kbat": { "type": "boolean" },
        "learning_objective": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Optional exact ID from the containing canonical topic's authored learning_objectives set."
        },
        "real_world_analogy": { "$ref": "#/$defs/nonEmptyString" },
        "misconception_alert": { "$ref": "#/$defs/nonEmptyString" },
        "scenario": { "$ref": "#/$defs/nonEmptyString" },
        "working": { "$ref": "#/$defs/nonEmptyString" },
        "source_ref": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    }
  }
}
